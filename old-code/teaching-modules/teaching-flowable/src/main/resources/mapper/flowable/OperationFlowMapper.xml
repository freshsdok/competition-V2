<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.flowable.mapper.OperationFlowMapper">

    <resultMap type="com.teaching.system.api.domain.OperationFlow" id="OperationFlowResult">
        <result property="teamCode"    column="team_code"    />
        <result property="flowId"    column="flow_id"    />
        <result property="flowType"    column="flow_type"    />
        <result property="flowStatus"    column="flow_status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectOperationFlowVo">
        select team_code, flow_id, flow_type,flow_status,create_time from operation_flow
    </sql>

    <select id="selectOperationFlowList" parameterType="com.teaching.system.api.domain.OperationFlow" resultMap="OperationFlowResult">
        <include refid="selectOperationFlowVo"/>
        <where>
            <if test="flowStatus != null and flowStatus != ''">
                and flow_status = #{flowStatus}
            </if>
            <if test="teamCode != null and teamCode != ''">
                and team_code = #{teamCode}
            </if>
            <if test="flowType != null and flowType != ''">
                and flow_type = #{flowType}
            </if>
        </where>
        order by team_code,flow_type,flow_status ,create_time desc
    </select>

    <select id="selectOperationNewFlow" parameterType="String" resultMap="OperationFlowResult">
        SELECT team_code, flow_id, flow_type, flow_status, create_time
        FROM (
        SELECT *,
        ROW_NUMBER() OVER (PARTITION BY team_code, flow_type ORDER BY create_time DESC) AS rn
        FROM operation_flow WHERE team_code = #{teamCode}
        ) t
        WHERE t.rn = 1
    </select>

    <select id="selectOperationFlowByTeamCode" parameterType="String" resultMap="OperationFlowResult">
        <include refid="selectOperationFlowVo"/>
        where team_code = #{teamCode}
    </select>

    <select id="getTeamCodeOperatorType" parameterType="String" resultMap="OperationFlowResult">
        <include refid="selectOperationFlowVo"/>
        where team_code = #{teamCode} and flow_status = 'completed'
        order by create_time desc limit 1
    </select>

    <insert id="insertOperationFlow" parameterType="com.teaching.system.api.domain.OperationFlow">
        insert into operation_flow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamCode != null">team_code,</if>
            <if test="flowId != null">flow_id,</if>
            <if test="flowType != null">flow_type,</if>
            <if test="flowStatus != null">flow_status,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamCode != null">#{teamCode},</if>
            <if test="flowId != null">#{flowId},</if>
            <if test="flowType != null">#{flowType},</if>
            <if test="flowStatus != null">#{flowStatus},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateStatusByFlowId" parameterType="com.teaching.system.api.domain.OperationFlow">
        update operation_flow
        <trim prefix="SET" suffixOverrides=",">
            <if test="flowStatus != null">flow_status = #{flowStatus},</if>
        </trim>
        where flow_id = #{flowId}
    </update>

    <delete id="deleteOperationFlowByTeamCode" parameterType="String">
        delete from operation_flow where team_code = #{teamCode}
    </delete>

    <delete id="deleteOperationFlowByTeamCodes" parameterType="String">
        delete from operation_flow where team_code in
        <foreach item="teamCode" collection="array" open="(" separator="," close=")">
            #{teamCode}
        </foreach>
    </delete>
</mapper>
