    <update id="updateCourseChapterInfo" parameterType="CourseChapterInfo">
        update course_chapter_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="chapterCode != null">chapter_code = #{chapterCode},</if>
            <if test="chapterName != null">chapter_name = #{chapterName},</if>
            <if test="chapterNum != null">chapter_num = #{chapterNum},</if>
