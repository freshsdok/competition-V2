    <delete id="deleteCourseInfoByCourseId" parameterType="Long">
        delete
        from course_info
        where course_id = #{courseId}
    </delete>

    <delete id="deleteCourseInfoByCourseIds" parameterType="String">
        delete from course_info where course_id in
        <foreach item="courseId" collection="array" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </delete>

    <delete id="deleteCourseChapterInfoByCourseIds" parameterType="String">
        delete from course_chapter_info where course_id in
        <foreach item="courseId" collection="array" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </delete>

    <delete id="deleteCourseChapterInfoByCourseId" parameterType="Long">
        delete
        from course_chapter_info
        where course_id = #{courseId}
    </delete>

    <select id="selectCourseChapterInfoByCourseId" parameterType="Long" resultMap="CourseChapterInfoResult">
    </select>

    <insert id="batchCourseChapterInfo">
        insert into course_chapter_info(  chapter_code, chapter_name, chapter_num, course_id, description,
        credit_hour, is_free, create_by, create_time, update_by, update_time, version, del_flag, user_id, org_id) values
        <foreach item="item" index="index" collection="list" separator=",">
            (  #{item.chapterCode}, #{item.chapterName}, #{item.chapterNum}, #{item.courseId},
            #{item.description}, #{item.creditHour}, #{item.isFree}, #{item.createBy}, #{item.createTime},
            #{item.updateBy}, #{item.updateTime}, #{item.version}, #{item.delFlag}, #{item.userId}, #{item.orgId})
        </foreach>
    </insert>

