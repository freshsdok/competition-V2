<!-- 课程带分类名称 -->
    <sql id="selectCourseInfoVo">
        select ci.course_id,
               ci.course_code,
               ci.school_code,
               ci.college_code,
               ci.name,
               ci.classify_id,
               ci.teacher,
               ci.credit_hour,
               ci.study_score,
               ci.price,
               ci.difficulty_level,
               ci.check_status,
               ci.apply_reason,
               ci.publish_status,
               ci.publish_time,
               ci.details,
               ci.cover_image,
               ci.create_by,
               ci.create_time,
               ci.update_by,
               ci.update_time,
               ci.version,
               ci.del_flag,
               ci.user_id,
               ci.org_id,
               cci.classify_name
        from course_info ci
        left join course_classify_info cci on ci.classify_id = cci.classify_id
    </sql>

    <select id="selectCourseInfoList" parameterType="CourseInfo" resultMap="CourseInfoCourseChapterInfoResult">
        <include refid="selectCourseInfoVo"/>
        <where>
            and ci.del_flag = '0' and cci.del_flag = '0'
            <if test="courseCode != null  and courseCode != ''">and ci.course_code = #{courseCode}</if>
            <if test="schoolCode != null  and schoolCode != ''">and ci.school_code = #{schoolCode}</if>
            <if test="collegeCode != null  and collegeCode != ''">and ci.college_code = #{collegeCode}</if>
            <if test="name != null  and name != ''">and ci.name like concat('%', #{name}, '%')</if>
            <if test="classifyId != null">and ci.classify_id = #{classifyId}</if>
            <if test="teacher != null  and teacher != ''">and ci.teacher = #{teacher}</if>
            <if test="creditHour != null  and creditHour != ''">and ci.credit_hour = #{creditHour}</if>
            <if test="studyScore != null  and studyScore != ''">and ci.study_score = #{studyScore}</if>
            <if test="price != null  and price != ''">and ci.price = #{price}</if>
            <if test="difficultyLevel != null  and difficultyLevel != ''">and ci.difficulty_level = #{difficultyLevel}</if>
            <if test="checkStatus != null  and checkStatus != ''">and ci.check_status = #{checkStatus}</if>
            <if test="applyReason != null  and applyReason != ''">and ci.apply_reason = #{applyReason}</if>
            <if test="publishStatus != null  and publishStatus != ''">and ci.publish_status = #{publishStatus}</if>
            <if test="publishTime != null ">and ci.publish_time = #{publishTime}</if>
            <if test="details != null  and details != ''">and ci.details = #{details}</if>
            <if test="coverImage != null  and coverImage != ''">and ci.cover_image = #{coverImage}</if>
            <if test="version != null ">and ci.version = #{version}</if>
            <if test="userId != null ">and ci.user_id = #{userId}</if>
            <if test="orgId != null ">and ci.org_id = #{orgId}</if>
        </where>
        order by ci.create_time desc
    </select>
<!-- 课程带分类名称详情 -->
