    <select id="hasUsedByClassifyId" resultType="Integer">
        select count(1)
        from course_info
        where del_flag = '0' and classify_id = #{classifyId}
    </select>
    <!-- 通过章节id 更新章节学时 -->
    <update id="updateChapterCreditHourByChapterId" parameterType="Long">
        UPDATE course_chapter_info cci
        SET credit_hour = (
            SELECT ROUND(SUM(video_duration) / 3600, 2)
            FROM course_chapter_video
            WHERE del_flag = '0' AND chapter_id = 1
        )
        WHERE chapter_id = #{chapterId}
    </update>

    <!-- 通过章节id 更新课程学时 -->
    <update id="updateCourseCreditHourByChapterId" parameterType="Long">
        UPDATE course_info ci
        SET credit_hour = (
            SELECT SUM(nullif(credit_hour,0))
            FROM course_chapter_info
            WHERE del_flag = '0'
              AND course_id = ci.course_id
        )
        WHERE EXISTS (
            SELECT 1
            FROM course_chapter_info
            WHERE chapter_id = #{chapterId}
              AND course_id = ci.course_id
        )
    </update>

    <!--章节详情带视频-->
    <select id="selectChapterAndVideoInfoByChapterId" resultMap="CourseChapterInfoResultAndVideos">
        select cchi.chapter_id,
               cchi.chapter_code,
               cchi.chapter_name,
               cchi.chapter_num,
               cchi.course_id,
               ci.`name` AS course_name,
               cchi.description,
               cchi.credit_hour,
               cchi.is_free,
               cchi.create_by,
               cchi.create_time,
               cchi.update_by,
               cchi.update_time,
               cchi.version,
               cchi.del_flag,
               cchi.user_id,
               cchi.org_id,
               ccvi.video_id,
               ccvi.video_name,
               ccvi.video_file,
               ccvi.video_num,
               ccvi.video_duration,
               ccvi.is_free,
               ccvi.expenses
        FROM course_chapter_info cchi
                 LEFT JOIN course_chapter_video ccvi on cchi.chapter_id = ccvi.chapter_id
                 LEFT JOIN course_info ci ON ci.course_id = cchi.course_id
        WHERE cchi.chapter_id = #{chapterId} AND cchi.del_flag = '0' AND ccvi.del_flag = '0' AND ccvi.check_status = '3'
    </select>
</mapper>
