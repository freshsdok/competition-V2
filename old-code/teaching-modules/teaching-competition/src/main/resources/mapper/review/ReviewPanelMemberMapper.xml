<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.review.mapper.ReviewPanelMemberMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewPanelMember" id="ReviewPanelMemberResult">
<id property="id" column="id"/>
<result property="activityId" column="activity_id"/>
<result property="roundId" column="round_id"/>
<result property="panelId" column="panel_id"/>
<result property="userId" column="user_id"/>
<result property="reviewerId" column="reviewer_id"/>
<result property="memberRole" column="member_role"/>
<result property="status" column="status"/>
<result property="createBy" column="create_by"/>
<result property="createTime" column="create_time"/>
<result property="updateBy" column="update_by"/>
<result property="updateTime" column="update_time"/>
<result property="remark" column="remark"/>
<result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectReviewPanelMemberVo">
        select id, activity_id, round_id, panel_id, user_id, reviewer_id, member_role, status, create_by, create_time, update_by, update_time, remark, del_flag
        from review_panel_member
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ReviewPanelMemberResult">
        <include refid="selectReviewPanelMemberVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectList" parameterType="com.teaching.competition.review.domain.ReviewPanelMember" resultMap="ReviewPanelMemberResult">
        <include refid="selectReviewPanelMemberVo"/>
        <where>
    del_flag = '0'
    <if test="activityId != null">
        and activity_id = #{activityId}
    </if>
    <if test="roundId != null">
        and round_id = #{roundId}
    </if>
    <if test="panelId != null">
        and panel_id = #{panelId}
    </if>
    <if test="userId != null">
        and user_id = #{userId}
    </if>
    <if test="reviewerId != null">
        and reviewer_id = #{reviewerId}
    </if>
    <if test="memberRole != null and memberRole != ''">
        and member_role = #{memberRole}
    </if>
    <if test="status != null and status != ''">
        and status = #{status}
    </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.teaching.competition.review.domain.ReviewPanelMember" useGeneratedKeys="true" keyProperty="id">
        insert into review_panel_member
        <trim prefix="(" suffix=")" suffixOverrides=",">
    <if test="activityId != null">activity_id,</if>
    <if test="roundId != null">round_id,</if>
    <if test="panelId != null">panel_id,</if>
    <if test="userId != null">user_id,</if>
    <if test="reviewerId != null">reviewer_id,</if>
    <if test="memberRole != null">member_role,</if>
    <if test="status != null">status,</if>
    <if test="createBy != null">create_by,</if>
    <if test="createTime != null">create_time,</if>
    <if test="updateBy != null">update_by,</if>
    <if test="updateTime != null">update_time,</if>
    <if test="remark != null">remark,</if>
    <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
    <if test="activityId != null">#{activityId},</if>
    <if test="roundId != null">#{roundId},</if>
    <if test="panelId != null">#{panelId},</if>
    <if test="userId != null">#{userId},</if>
    <if test="reviewerId != null">#{reviewerId},</if>
    <if test="memberRole != null">#{memberRole},</if>
    <if test="status != null">#{status},</if>
    <if test="createBy != null">#{createBy},</if>
    <if test="createTime != null">#{createTime},</if>
    <if test="updateBy != null">#{updateBy},</if>
    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewPanelMember">
        update review_panel_member
        <set>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="roundId != null">round_id = #{roundId},</if>
    <if test="panelId != null">panel_id = #{panelId},</if>
    <if test="userId != null">user_id = #{userId},</if>
    <if test="reviewerId != null">reviewer_id = #{reviewerId},</if>
    <if test="memberRole != null">member_role = #{memberRole},</if>
    <if test="status != null">status = #{status},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <update id="deleteByIds">
        update review_panel_member
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
