<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.review.mapper.ReviewAuditLogMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewAuditLog" id="ReviewAuditLogResult">
<id property="id" column="id"/>
<result property="activityId" column="activity_id"/>
<result property="roundId" column="round_id"/>
<result property="objectId" column="object_id"/>
<result property="bizType" column="biz_type"/>
<result property="bizId" column="biz_id"/>
<result property="actionType" column="action_type"/>
<result property="actionContent" column="action_content"/>
<result property="operatorUserId" column="operator_user_id"/>
<result property="operatorName" column="operator_name"/>
<result property="operateTime" column="operate_time"/>
<result property="ipAddr" column="ip_addr"/>
<result property="createBy" column="create_by"/>
<result property="createTime" column="create_time"/>
<result property="updateBy" column="update_by"/>
<result property="updateTime" column="update_time"/>
<result property="remark" column="remark"/>
<result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectReviewAuditLogVo">
        select id, activity_id, round_id, object_id, biz_type, biz_id, action_type, action_content, operator_user_id, operator_name, operate_time, ip_addr, create_by, create_time, update_by, update_time, remark, del_flag
        from review_audit_log
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ReviewAuditLogResult">
        <include refid="selectReviewAuditLogVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectList" parameterType="com.teaching.competition.review.domain.ReviewAuditLog" resultMap="ReviewAuditLogResult">
        <include refid="selectReviewAuditLogVo"/>
        <where>
    del_flag = '0'
    <if test="activityId != null">
        and activity_id = #{activityId}
    </if>
    <if test="roundId != null">
        and round_id = #{roundId}
    </if>
    <if test="objectId != null">
        and object_id = #{objectId}
    </if>
    <if test="bizType != null and bizType != ''">
        and biz_type = #{bizType}
    </if>
    <if test="bizId != null and bizId != ''">
        and biz_id = #{bizId}
    </if>
    <if test="actionType != null and actionType != ''">
        and action_type = #{actionType}
    </if>
    <if test="actionContent != null and actionContent != ''">
        and action_content like concat('%', #{actionContent}, '%')
    </if>
    <if test="operatorUserId != null">
        and operator_user_id = #{operatorUserId}
    </if>
    <if test="operatorName != null and operatorName != ''">
        and operator_name like concat('%', #{operatorName}, '%')
    </if>
    <if test="operateTime != null">
        and operate_time = #{operateTime}
    </if>
    <if test="ipAddr != null and ipAddr != ''">
        and ip_addr = #{ipAddr}
    </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.teaching.competition.review.domain.ReviewAuditLog" useGeneratedKeys="true" keyProperty="id">
        insert into review_audit_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
    <if test="activityId != null">activity_id,</if>
    <if test="roundId != null">round_id,</if>
    <if test="objectId != null">object_id,</if>
    <if test="bizType != null">biz_type,</if>
    <if test="bizId != null">biz_id,</if>
    <if test="actionType != null">action_type,</if>
    <if test="actionContent != null">action_content,</if>
    <if test="operatorUserId != null">operator_user_id,</if>
    <if test="operatorName != null">operator_name,</if>
    <if test="operateTime != null">operate_time,</if>
    <if test="ipAddr != null">ip_addr,</if>
    <if test="createBy != null">create_by,</if>
    <if test="createTime != null">create_time,</if>
    <if test="updateBy != null">update_by,</if>
    <if test="updateTime != null">update_time,</if>
    <if test="remark != null">remark,</if>
    <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
    <if test="activityId != null">#{activityId},</if>
    <if test="roundId != null">#{roundId},</if>
    <if test="objectId != null">#{objectId},</if>
    <if test="bizType != null">#{bizType},</if>
    <if test="bizId != null">#{bizId},</if>
    <if test="actionType != null">#{actionType},</if>
    <if test="actionContent != null">#{actionContent},</if>
    <if test="operatorUserId != null">#{operatorUserId},</if>
    <if test="operatorName != null">#{operatorName},</if>
    <if test="operateTime != null">#{operateTime},</if>
    <if test="ipAddr != null">#{ipAddr},</if>
    <if test="createBy != null">#{createBy},</if>
    <if test="createTime != null">#{createTime},</if>
    <if test="updateBy != null">#{updateBy},</if>
    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewAuditLog">
        update review_audit_log
        <set>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="roundId != null">round_id = #{roundId},</if>
    <if test="objectId != null">object_id = #{objectId},</if>
    <if test="bizType != null">biz_type = #{bizType},</if>
    <if test="bizId != null">biz_id = #{bizId},</if>
    <if test="actionType != null">action_type = #{actionType},</if>
    <if test="actionContent != null">action_content = #{actionContent},</if>
    <if test="operatorUserId != null">operator_user_id = #{operatorUserId},</if>
    <if test="operatorName != null">operator_name = #{operatorName},</if>
    <if test="operateTime != null">operate_time = #{operateTime},</if>
    <if test="ipAddr != null">ip_addr = #{ipAddr},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <update id="deleteByIds">
        update review_audit_log
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
