<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.review.mapper.ReviewScoreDetailMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewScoreDetail" id="ReviewScoreDetailResult">
<id property="id" column="id"/>
<result property="recordId" column="record_id"/>
<result property="activityId" column="activity_id"/>
<result property="roundId" column="round_id"/>
<result property="objectId" column="object_id"/>
<result property="criteriaId" column="criteria_id"/>
<result property="criteriaName" column="criteria_name"/>
<result property="scoreType" column="score_type"/>
<result property="scoreValue" column="score_value"/>
<result property="optionValue" column="option_value"/>
<result property="textValue" column="text_value"/>
<result property="weight" column="weight"/>
<result property="sortOrder" column="sort_order"/>
<result property="createBy" column="create_by"/>
<result property="createTime" column="create_time"/>
<result property="updateBy" column="update_by"/>
<result property="updateTime" column="update_time"/>
<result property="remark" column="remark"/>
<result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectReviewScoreDetailVo">
        select id, record_id, activity_id, round_id, object_id, criteria_id, criteria_name, score_type, score_value, option_value, text_value, weight, sort_order, create_by, create_time, update_by, update_time, remark, del_flag
        from review_score_detail
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ReviewScoreDetailResult">
        <include refid="selectReviewScoreDetailVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectList" parameterType="com.teaching.competition.review.domain.ReviewScoreDetail" resultMap="ReviewScoreDetailResult">
        <include refid="selectReviewScoreDetailVo"/>
        <where>
    del_flag = '0'
    <if test="recordId != null">
        and record_id = #{recordId}
    </if>
    <if test="activityId != null">
        and activity_id = #{activityId}
    </if>
    <if test="roundId != null">
        and round_id = #{roundId}
    </if>
    <if test="objectId != null">
        and object_id = #{objectId}
    </if>
    <if test="criteriaId != null">
        and criteria_id = #{criteriaId}
    </if>
    <if test="criteriaName != null and criteriaName != ''">
        and criteria_name like concat('%', #{criteriaName}, '%')
    </if>
    <if test="scoreType != null and scoreType != ''">
        and score_type = #{scoreType}
    </if>
    <if test="scoreValue != null">
        and score_value = #{scoreValue}
    </if>
    <if test="optionValue != null and optionValue != ''">
        and option_value = #{optionValue}
    </if>
    <if test="textValue != null and textValue != ''">
        and text_value = #{textValue}
    </if>
    <if test="weight != null">
        and weight = #{weight}
    </if>
    <if test="sortOrder != null">
        and sort_order = #{sortOrder}
    </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.teaching.competition.review.domain.ReviewScoreDetail" useGeneratedKeys="true" keyProperty="id">
        insert into review_score_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
    <if test="recordId != null">record_id,</if>
    <if test="activityId != null">activity_id,</if>
    <if test="roundId != null">round_id,</if>
    <if test="objectId != null">object_id,</if>
    <if test="criteriaId != null">criteria_id,</if>
    <if test="criteriaName != null">criteria_name,</if>
    <if test="scoreType != null">score_type,</if>
    <if test="scoreValue != null">score_value,</if>
    <if test="optionValue != null">option_value,</if>
    <if test="textValue != null">text_value,</if>
    <if test="weight != null">weight,</if>
    <if test="sortOrder != null">sort_order,</if>
    <if test="createBy != null">create_by,</if>
    <if test="createTime != null">create_time,</if>
    <if test="updateBy != null">update_by,</if>
    <if test="updateTime != null">update_time,</if>
    <if test="remark != null">remark,</if>
    <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
    <if test="recordId != null">#{recordId},</if>
    <if test="activityId != null">#{activityId},</if>
    <if test="roundId != null">#{roundId},</if>
    <if test="objectId != null">#{objectId},</if>
    <if test="criteriaId != null">#{criteriaId},</if>
    <if test="criteriaName != null">#{criteriaName},</if>
    <if test="scoreType != null">#{scoreType},</if>
    <if test="scoreValue != null">#{scoreValue},</if>
    <if test="optionValue != null">#{optionValue},</if>
    <if test="textValue != null">#{textValue},</if>
    <if test="weight != null">#{weight},</if>
    <if test="sortOrder != null">#{sortOrder},</if>
    <if test="createBy != null">#{createBy},</if>
    <if test="createTime != null">#{createTime},</if>
    <if test="updateBy != null">#{updateBy},</if>
    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewScoreDetail">
        update review_score_detail
        <set>
    <if test="recordId != null">record_id = #{recordId},</if>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="roundId != null">round_id = #{roundId},</if>
    <if test="objectId != null">object_id = #{objectId},</if>
    <if test="criteriaId != null">criteria_id = #{criteriaId},</if>
    <if test="criteriaName != null">criteria_name = #{criteriaName},</if>
    <if test="scoreType != null">score_type = #{scoreType},</if>
    <if test="scoreValue != null">score_value = #{scoreValue},</if>
    <if test="optionValue != null">option_value = #{optionValue},</if>
    <if test="textValue != null">text_value = #{textValue},</if>
    <if test="weight != null">weight = #{weight},</if>
    <if test="sortOrder != null">sort_order = #{sortOrder},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <update id="deleteByIds">
        update review_score_detail
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deleteByRecordId">
        update review_score_detail
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where record_id = #{recordId} and del_flag = '0'
    </update>
</mapper>
