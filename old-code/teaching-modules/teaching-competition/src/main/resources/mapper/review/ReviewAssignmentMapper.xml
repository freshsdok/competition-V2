<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.review.mapper.ReviewAssignmentMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewAssignment" id="ReviewAssignmentResult">
<id property="id" column="id"/>
<result property="activityId" column="activity_id"/>
<result property="roundId" column="round_id"/>
<result property="objectId" column="object_id"/>
<result property="reviewerId" column="reviewer_id"/>
<result property="reviewerUserId" column="reviewer_user_id"/>
<result property="panelId" column="panel_id"/>
<result property="assignmentType" column="assignment_type"/>
<result property="status" column="status"/>
<result property="assignedBy" column="assigned_by"/>
<result property="assignedTime" column="assigned_time"/>
<result property="submittedTime" column="submitted_time"/>
<result property="createBy" column="create_by"/>
<result property="createTime" column="create_time"/>
<result property="updateBy" column="update_by"/>
<result property="updateTime" column="update_time"/>
<result property="remark" column="remark"/>
<result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectReviewAssignmentVo">
        select id, activity_id, round_id, object_id, reviewer_id, reviewer_user_id, panel_id, assignment_type, status, assigned_by, assigned_time, submitted_time, create_by, create_time, update_by, update_time, remark, del_flag
        from review_assignment
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ReviewAssignmentResult">
        <include refid="selectReviewAssignmentVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectList" parameterType="com.teaching.competition.review.domain.ReviewAssignment" resultMap="ReviewAssignmentResult">
        <include refid="selectReviewAssignmentVo"/>
        <where>
    del_flag = '0'
    <if test="activityId != null">
        and activity_id = #{activityId}
    </if>
    <if test="roundId != null">
        and round_id = #{roundId}
    </if>
    <if test="objectId != null">
        and object_id = #{objectId}
    </if>
    <if test="reviewerId != null">
        and reviewer_id = #{reviewerId}
    </if>
    <if test="reviewerUserId != null">
        and reviewer_user_id = #{reviewerUserId}
    </if>
    <if test="panelId != null">
        and panel_id = #{panelId}
    </if>
    <if test="assignmentType != null and assignmentType != ''">
        and assignment_type = #{assignmentType}
    </if>
    <if test="status != null and status != ''">
        and status = #{status}
    </if>
    <if test="assignedBy != null">
        and assigned_by = #{assignedBy}
    </if>
    <if test="assignedTime != null">
        and assigned_time = #{assignedTime}
    </if>
    <if test="submittedTime != null">
        and submitted_time = #{submittedTime}
    </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.teaching.competition.review.domain.ReviewAssignment" useGeneratedKeys="true" keyProperty="id">
        insert into review_assignment
        <trim prefix="(" suffix=")" suffixOverrides=",">
    <if test="activityId != null">activity_id,</if>
    <if test="roundId != null">round_id,</if>
    <if test="objectId != null">object_id,</if>
    <if test="reviewerId != null">reviewer_id,</if>
    <if test="reviewerUserId != null">reviewer_user_id,</if>
    <if test="panelId != null">panel_id,</if>
    <if test="assignmentType != null">assignment_type,</if>
    <if test="status != null">status,</if>
    <if test="assignedBy != null">assigned_by,</if>
    <if test="assignedTime != null">assigned_time,</if>
    <if test="submittedTime != null">submitted_time,</if>
    <if test="createBy != null">create_by,</if>
    <if test="createTime != null">create_time,</if>
    <if test="updateBy != null">update_by,</if>
    <if test="updateTime != null">update_time,</if>
    <if test="remark != null">remark,</if>
    <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
    <if test="activityId != null">#{activityId},</if>
    <if test="roundId != null">#{roundId},</if>
    <if test="objectId != null">#{objectId},</if>
    <if test="reviewerId != null">#{reviewerId},</if>
    <if test="reviewerUserId != null">#{reviewerUserId},</if>
    <if test="panelId != null">#{panelId},</if>
    <if test="assignmentType != null">#{assignmentType},</if>
    <if test="status != null">#{status},</if>
    <if test="assignedBy != null">#{assignedBy},</if>
    <if test="assignedTime != null">#{assignedTime},</if>
    <if test="submittedTime != null">#{submittedTime},</if>
    <if test="createBy != null">#{createBy},</if>
    <if test="createTime != null">#{createTime},</if>
    <if test="updateBy != null">#{updateBy},</if>
    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewAssignment">
        update review_assignment
        <set>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="roundId != null">round_id = #{roundId},</if>
    <if test="objectId != null">object_id = #{objectId},</if>
    <if test="reviewerId != null">reviewer_id = #{reviewerId},</if>
    <if test="reviewerUserId != null">reviewer_user_id = #{reviewerUserId},</if>
    <if test="panelId != null">panel_id = #{panelId},</if>
    <if test="assignmentType != null">assignment_type = #{assignmentType},</if>
    <if test="status != null">status = #{status},</if>
    <if test="assignedBy != null">assigned_by = #{assignedBy},</if>
    <if test="assignedTime != null">assigned_time = #{assignedTime},</if>
    <if test="submittedTime != null">submitted_time = #{submittedTime},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <update id="deleteByIds">
        update review_assignment
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
