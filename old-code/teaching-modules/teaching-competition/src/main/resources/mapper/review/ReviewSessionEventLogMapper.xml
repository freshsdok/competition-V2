<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.review.mapper.ReviewSessionEventLogMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewSessionEventLog" id="ReviewSessionEventLogResult">
<id property="id" column="id"/>
<result property="activityId" column="activity_id"/>
<result property="roundId" column="round_id"/>
<result property="sessionId" column="session_id"/>
<result property="objectId" column="object_id"/>
<result property="eventType" column="event_type"/>
<result property="eventContent" column="event_content"/>
<result property="operatorUserId" column="operator_user_id"/>
<result property="eventTime" column="event_time"/>
<result property="createBy" column="create_by"/>
<result property="createTime" column="create_time"/>
<result property="updateBy" column="update_by"/>
<result property="updateTime" column="update_time"/>
<result property="remark" column="remark"/>
<result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectReviewSessionEventLogVo">
        select id, activity_id, round_id, session_id, object_id, event_type, event_content, operator_user_id, event_time, create_by, create_time, update_by, update_time, remark, del_flag
        from review_session_event_log
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ReviewSessionEventLogResult">
        <include refid="selectReviewSessionEventLogVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectList" parameterType="com.teaching.competition.review.domain.ReviewSessionEventLog" resultMap="ReviewSessionEventLogResult">
        <include refid="selectReviewSessionEventLogVo"/>
        <where>
    del_flag = '0'
    <if test="activityId != null">
        and activity_id = #{activityId}
    </if>
    <if test="roundId != null">
        and round_id = #{roundId}
    </if>
    <if test="sessionId != null">
        and session_id = #{sessionId}
    </if>
    <if test="objectId != null">
        and object_id = #{objectId}
    </if>
    <if test="eventType != null and eventType != ''">
        and event_type = #{eventType}
    </if>
    <if test="eventContent != null and eventContent != ''">
        and event_content like concat('%', #{eventContent}, '%')
    </if>
    <if test="operatorUserId != null">
        and operator_user_id = #{operatorUserId}
    </if>
    <if test="eventTime != null">
        and event_time = #{eventTime}
    </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.teaching.competition.review.domain.ReviewSessionEventLog" useGeneratedKeys="true" keyProperty="id">
        insert into review_session_event_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
    <if test="activityId != null">activity_id,</if>
    <if test="roundId != null">round_id,</if>
    <if test="sessionId != null">session_id,</if>
    <if test="objectId != null">object_id,</if>
    <if test="eventType != null">event_type,</if>
    <if test="eventContent != null">event_content,</if>
    <if test="operatorUserId != null">operator_user_id,</if>
    <if test="eventTime != null">event_time,</if>
    <if test="createBy != null">create_by,</if>
    <if test="createTime != null">create_time,</if>
    <if test="updateBy != null">update_by,</if>
    <if test="updateTime != null">update_time,</if>
    <if test="remark != null">remark,</if>
    <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
    <if test="activityId != null">#{activityId},</if>
    <if test="roundId != null">#{roundId},</if>
    <if test="sessionId != null">#{sessionId},</if>
    <if test="objectId != null">#{objectId},</if>
    <if test="eventType != null">#{eventType},</if>
    <if test="eventContent != null">#{eventContent},</if>
    <if test="operatorUserId != null">#{operatorUserId},</if>
    <if test="eventTime != null">#{eventTime},</if>
    <if test="createBy != null">#{createBy},</if>
    <if test="createTime != null">#{createTime},</if>
    <if test="updateBy != null">#{updateBy},</if>
    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewSessionEventLog">
        update review_session_event_log
        <set>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="roundId != null">round_id = #{roundId},</if>
    <if test="sessionId != null">session_id = #{sessionId},</if>
    <if test="objectId != null">object_id = #{objectId},</if>
    <if test="eventType != null">event_type = #{eventType},</if>
    <if test="eventContent != null">event_content = #{eventContent},</if>
    <if test="operatorUserId != null">operator_user_id = #{operatorUserId},</if>
    <if test="eventTime != null">event_time = #{eventTime},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <update id="deleteByIds">
        update review_session_event_log
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
