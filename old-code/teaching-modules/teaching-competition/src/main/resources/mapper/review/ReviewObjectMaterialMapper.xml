<mapper namespace="com.teaching.competition.review.mapper.ReviewObjectMaterialMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewObjectMaterial" id="ReviewObjectMaterialResult">
<id property="id" column="id"/>
<result property="activityId" column="activity_id"/>
<result property="objectId" column="object_id"/>
<result property="materialName" column="material_name"/>
<result property="materialType" column="material_type"/>
<result property="fileName" column="file_name"/>
<result property="fileUrl" column="file_url"/>
<result property="fileSize" column="file_size"/>
<result property="mimeType" column="mime_type"/>
<result property="fileExt" column="file_ext"/>
<result property="visibleToReviewer" column="visible_to_reviewer"/>
