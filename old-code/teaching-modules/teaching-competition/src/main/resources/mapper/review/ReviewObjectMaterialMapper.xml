    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewObjectMaterial">
        update review_object_material
        <set>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="objectId != null">object_id = #{objectId},</if>
    <if test="materialName != null">material_name = #{materialName},</if>
    <if test="materialType != null">material_type = #{materialType},</if>
    <if test="fileName != null">file_name = #{fileName},</if>
    <if test="fileUrl != null">file_url = #{fileUrl},</if>
    <if test="fileSize != null">file_size = #{fileSize},</if>
    <if test="mimeType != null">mime_type = #{mimeType},</if>
    <if test="fileExt != null">file_ext = #{fileExt},</if>
    <if test="visibleToReviewer != null">visible_to_reviewer = #{visibleToReviewer},</if>
    <if test="sortOrder != null">sort_order = #{sortOrder},</if>
    <if test="uploadBy != null">upload_by = #{uploadBy},</if>
    <if test="uploadTime != null">upload_time = #{uploadTime},</if>
    <if test="status != null">status = #{status},</if>
    <if test="sourceModule != null">source_module = #{sourceModule},</if>
    <if test="sourceBizType != null">source_biz_type = #{sourceBizType},</if>
    <if test="sourceBizId != null">source_biz_id = #{sourceBizId},</if>
    <if test="sourceMaterialKey != null">source_material_key = #{sourceMaterialKey},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
