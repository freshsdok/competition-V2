    <if test="grantedTime != null">#{grantedTime},</if>
    <if test="usedTime != null">#{usedTime},</if>
    <if test="createBy != null">#{createBy},</if>
    <if test="createTime != null">#{createTime},</if>
    <if test="updateBy != null">#{updateBy},</if>
    <if test="updateTime != null">#{updateTime},</if>
    <if test="remark != null">#{remark},</if>
    <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.teaching.competition.review.domain.ReviewSubmissionPermission">
        update review_submission_permission
        <set>
    <if test="activityId != null">activity_id = #{activityId},</if>
    <if test="objectId != null">object_id = #{objectId},</if>
    <if test="userId != null">user_id = #{userId},</if>
    <if test="orgId != null">org_id = #{orgId},</if>
    <if test="permissionType != null">permission_type = #{permissionType},</if>
    <if test="status != null">status = #{status},</if>
    <if test="sourceModule != null">source_module = #{sourceModule},</if>
    <if test="sourceBizId != null">source_biz_id = #{sourceBizId},</if>
    <if test="grantedBy != null">granted_by = #{grantedBy},</if>
    <if test="grantedTime != null">granted_time = #{grantedTime},</if>
    <if test="usedTime != null">used_time = #{usedTime},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <update id="deleteByIds">
        update review_submission_permission
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deleteByObjectId">
        update review_submission_permission
        set del_flag = '1', update_by = #{updateBy}, update_time = now()
        where activity_id = #{activityId}
          and object_id = #{objectId}
          and del_flag = '0'
    </update>
</mapper>
