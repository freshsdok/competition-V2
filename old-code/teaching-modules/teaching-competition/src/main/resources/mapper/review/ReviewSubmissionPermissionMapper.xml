        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.review.mapper.ReviewSubmissionPermissionMapper">

    <resultMap type="com.teaching.competition.review.domain.ReviewSubmissionPermission" id="ReviewSubmissionPermissionResult">
<id property="id" column="id"/>
<result property="activityId" column="activity_id"/>
<result property="objectId" column="object_id"/>
<result property="userId" column="user_id"/>
<result property="orgId" column="org_id"/>
<result property="permissionType" column="permission_type"/>
<result property="status" column="status"/>
<result property="sourceModule" column="source_module"/>
