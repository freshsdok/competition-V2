    <sql id="selectReviewSubmissionPermissionVo">
        select id, activity_id, object_id, user_id, org_id, permission_type, status, source_module, source_biz_id, granted_by, granted_time, used_time, create_by, create_time, update_by, update_time, remark, del_flag
        from review_submission_permission
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ReviewSubmissionPermissionResult">
        <include refid="selectReviewSubmissionPermissionVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectList" parameterType="com.teaching.competition.review.domain.ReviewSubmissionPermission" resultMap="ReviewSubmissionPermissionResult">
        <include refid="selectReviewSubmissionPermissionVo"/>
        <where>
    del_flag = '0'
    <if test="activityId != null">
        and activity_id = #{activityId}
    </if>
    <if test="objectId != null">
        and object_id = #{objectId}
    </if>
    <if test="userId != null">
        and user_id = #{userId}
    </if>
    <if test="orgId != null">
        and org_id = #{orgId}
    </if>
    <if test="permissionType != null and permissionType != ''">
        and permission_type = #{permissionType}
    </if>
    <if test="status != null and status != ''">
        and status = #{status}
    </if>
    <if test="sourceModule != null and sourceModule != ''">
        and source_module = #{sourceModule}
    </if>
    <if test="sourceBizId != null and sourceBizId != ''">
        and source_biz_id = #{sourceBizId}
    </if>
    <if test="grantedBy != null">
        and granted_by = #{grantedBy}
    </if>
    <if test="grantedTime != null">
        and granted_time = #{grantedTime}
    </if>
    <if test="usedTime != null">
        and used_time = #{usedTime}
    </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.teaching.competition.review.domain.ReviewSubmissionPermission" useGeneratedKeys="true" keyProperty="id">
        insert into review_submission_permission
        <trim prefix="(" suffix=")" suffixOverrides=",">
    <if test="activityId != null">activity_id,</if>
    <if test="objectId != null">object_id,</if>
    <if test="userId != null">user_id,</if>
    <if test="orgId != null">org_id,</if>
    <if test="permissionType != null">permission_type,</if>
    <if test="status != null">status,</if>
    <if test="sourceModule != null">source_module,</if>
    <if test="sourceBizId != null">source_biz_id,</if>
    <if test="grantedBy != null">granted_by,</if>
    <if test="grantedTime != null">granted_time,</if>
    <if test="usedTime != null">used_time,</if>
    <if test="createBy != null">create_by,</if>
    <if test="createTime != null">create_time,</if>
    <if test="updateBy != null">update_by,</if>
    <if test="updateTime != null">update_time,</if>
    <if test="remark != null">remark,</if>
    <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
    <if test="activityId != null">#{activityId},</if>
    <if test="objectId != null">#{objectId},</if>
    <if test="userId != null">#{userId},</if>
    <if test="orgId != null">#{orgId},</if>
    <if test="permissionType != null">#{permissionType},</if>
    <if test="status != null">#{status},</if>
