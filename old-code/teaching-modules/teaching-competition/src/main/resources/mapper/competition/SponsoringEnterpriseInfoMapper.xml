<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.mapper.SponsoringEnterpriseInfoMapper">

    <resultMap type="com.teaching.competition.domain.SponsoringEnterpriseInfo" id="SponsoringEnterpriseInfoResult">
        <result property="enterpriseId" column="enterprise_id"/>
        <result property="enterpriseName" column="enterprise_name"/>
        <result property="enterpriseDesc" column="enterprise_desc"/>
        <result property="enterpriseLogo" column="enterprise_logo"/>
        <result property="contactPerson" column="contact_person"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="enterpriseAddr" column="enterprise_addr"/>
        <result property="officialWebsiteLink" column="official_website_link"/>
        <result property="spopAmount" column="spop_amount"/>
        <result property="type" column="type"/>
        <result property="coptStartTime" column="copt_start_time"/>
        <result property="coptEndTime" column="copt_end_time"/>
        <result property="displayStatus" column="display_status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="version" column="version"/>
        <result property="delFlag" column="del_flag"/>
        <result property="userId" column="user_id"/>
        <result property="orgId" column="org_id"/>
    </resultMap>

    <sql id="selectSponsoringEnterpriseInfoVo">
        select enterprise_id, enterprise_name, enterprise_desc, enterprise_logo, contact_person, phone, email,
        enterprise_addr, official_website_link, spop_amount, type, copt_start_time, copt_end_time, display_status,
        create_by, create_time, update_by, update_time, version, del_flag, user_id, org_id from
        sponsoring_enterprise_info
    </sql>

    <select id="selectSponsoringEnterpriseInfoList"
            parameterType="com.teaching.competition.domain.SponsoringEnterpriseInfo"
            resultMap="SponsoringEnterpriseInfoResult">
        select a.enterprise_id, a.enterprise_name, a.enterprise_desc, a.enterprise_logo, a.contact_person, a.phone, a.email,
        a.enterprise_addr, a.official_website_link, a.spop_amount, a.type, a.copt_start_time, a.copt_end_time, a.display_status,
        a.create_by, a.create_time, a.update_by, a.update_time, a.version, a.del_flag, a.user_id, a.org_id from
        sponsoring_enterprise_info a
        where a.del_flag = '0'
        <if test="enterpriseName != null  and enterpriseName != ''">
            and a.enterprise_name like concat('%', #{enterpriseName}, '%')
        </if>
        <if test="contactPerson != null  and contactPerson != ''">
            and a.contact_person like concat('%', #{contactPerson}, '%')
        </if>
        <if test="phone != null  and phone != ''">
            and a.phone like concat('%', #{phone}, '%')
        </if>
        <if test="email != null  and email != ''">
            and a.email like concat('%', #{email}, '%')
        </if>
        <if test="enterpriseAddr != null  and enterpriseAddr != ''">
            and a.enterprise_addr like concat('%', #{enterpriseAddr}, '%')
        </if>
        <if test="spopAmountStart != null ">
            and a.spop_amount >= #{spopAmountStart}
        </if>
        <if test="spopAmountEnd != null ">
            and a.spop_amount &lt;= #{spopAmountEnd}
        </if>
        <if test="type != null  and type != ''">
            and a.type = #{type}
        </if>
        <if test="displayStatus != null  and displayStatus != ''">
            and a.display_status = #{displayStatus}
        </if>
        <if test="coptStartTime != null">
            and a.copt_start_time >= #{coptStartTime}
        </if>
        <if test="coptEndTime != null">
            and a.copt_end_time &lt; #{coptEndTime}
        </if>
        <!-- 数据范围过滤 -->
        ${params.dataScope}
    </select>

    <select id="selectSponsoringEnterpriseInfoByEnterpriseId" parameterType="Long"
            resultMap="SponsoringEnterpriseInfoResult">
        <include refid="selectSponsoringEnterpriseInfoVo"/>
        where enterprise_id = #{enterpriseId} and del_flag = '0'
    </select>

    <insert id="insertSponsoringEnterpriseInfo" parameterType="com.teaching.competition.domain.SponsoringEnterpriseInfo"
            useGeneratedKeys="true" keyProperty="enterpriseId">
        insert into sponsoring_enterprise_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="enterpriseName != null">enterprise_name,</if>
            <if test="enterpriseDesc != null">enterprise_desc,</if>
            <if test="enterpriseLogo != null">enterprise_logo,</if>
            <if test="contactPerson != null">contact_person,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="enterpriseAddr != null">enterprise_addr,</if>
            <if test="officialWebsiteLink != null">official_website_link,</if>
            <if test="spopAmount != null">spop_amount,</if>
            <if test="type != null">type,</if>
            <if test="coptStartTime != null">copt_start_time,</if>
            <if test="coptEndTime != null">copt_end_time,</if>
            <if test="displayStatus != null">display_status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="userId != null">user_id,</if>
            <if test="orgId != null">org_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="enterpriseName != null">#{enterpriseName},</if>
            <if test="enterpriseDesc != null">#{enterpriseDesc},</if>
            <if test="enterpriseLogo != null">#{enterpriseLogo},</if>
            <if test="contactPerson != null">#{contactPerson},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="enterpriseAddr != null">#{enterpriseAddr},</if>
            <if test="officialWebsiteLink != null">#{officialWebsiteLink},</if>
            <if test="spopAmount != null">#{spopAmount},</if>
            <if test="type != null">#{type},</if>
            <if test="coptStartTime != null">#{coptStartTime},</if>
            <if test="coptEndTime != null">#{coptEndTime},</if>
            <if test="displayStatus != null">#{displayStatus},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="userId != null">#{userId},</if>
            <if test="orgId != null">#{orgId},</if>
        </trim>
    </insert>

    <update id="updateSponsoringEnterpriseInfo"
            parameterType="com.teaching.competition.domain.SponsoringEnterpriseInfo">
        update sponsoring_enterprise_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="enterpriseName != null">enterprise_name = #{enterpriseName},</if>
            <if test="enterpriseDesc != null">enterprise_desc = #{enterpriseDesc},</if>
            <if test="enterpriseLogo != null">enterprise_logo = #{enterpriseLogo},</if>
            <if test="contactPerson != null">contact_person = #{contactPerson},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="enterpriseAddr != null">enterprise_addr = #{enterpriseAddr},</if>
            <if test="officialWebsiteLink != null">official_website_link = #{officialWebsiteLink},</if>
            <if test="spopAmount != null">spop_amount = #{spopAmount},</if>
            <if test="type != null">type = #{type},</if>
            <if test="coptStartTime != null">copt_start_time = #{coptStartTime},</if>
            <if test="coptEndTime != null">copt_end_time = #{coptEndTime},</if>
            <if test="displayStatus != null">display_status = #{displayStatus},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            version = version+1,
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="orgId != null">org_id = #{orgId},</if>
        </trim>
        where enterprise_id = #{enterpriseId}
    </update>

    <delete id="deleteSponsoringEnterpriseInfoByEnterpriseId" parameterType="Long">
        update sponsoring_enterprise_info set del_flag = '1',update_time = now(),version = version+1 where enterprise_id = #{enterpriseId}
    </delete>

    <delete id="deleteSponsoringEnterpriseInfoByEnterpriseIds" parameterType="String">
        update sponsoring_enterprise_info set del_flag = '1',update_time = now(),version = version+1 where enterprise_id in
        <foreach item="enterpriseId" collection="array" open="(" separator="," close=")">
            #{enterpriseId}
        </foreach>
    </delete>
</mapper>