<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.mapper.CompetitionCheckDataPackageMapper">

    <resultMap type="CompetitionCheckDataPackage" id="CompetitionCheckDataPackageResult">
        <result property="packageId"    column="package_id"    />
        <result property="packageName"    column="package_name"    />
        <result property="packageJson"    column="package_json"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectCompetitionCheckDataPackageVo">
        select package_id, package_name, package_json, create_by, create_time, update_by, update_time, version, del_flag from competition_check_data_package
    </sql>

    <select id="selectCompetitionCheckDataPackageList" parameterType="CompetitionCheckDataPackage" resultMap="CompetitionCheckDataPackageResult">
        <include refid="selectCompetitionCheckDataPackageVo"/>
        <where>
            AND del_flag = '0'
            <if test="packageName != null  and packageName != ''"> and package_name like concat('%', #{packageName}, '%')</if>
            <if test="packageJson != null  and packageJson != ''"> and package_json = #{packageJson}</if>
            <if test="version != null "> and version = #{version}</if>
        </where>
    </select>

    <select id="selectCompetitionCheckDataPackageByPackageId" parameterType="Long" resultMap="CompetitionCheckDataPackageResult">
        <include refid="selectCompetitionCheckDataPackageVo"/>
        where package_id = #{packageId}
    </select>

    <insert id="insertCompetitionCheckDataPackage" parameterType="CompetitionCheckDataPackage" useGeneratedKeys="true" keyProperty="packageId">
        insert into competition_check_data_package
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="packageName != null">package_name,</if>
            <if test="packageJson != null">package_json,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="packageName != null">#{packageName},</if>
            <if test="packageJson != null">#{packageJson},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateCompetitionCheckDataPackage" parameterType="CompetitionCheckDataPackage">
        update competition_check_data_package
        <trim prefix="SET" suffixOverrides=",">
            <if test="packageName != null">package_name = #{packageName},</if>
            <if test="packageJson != null">package_json = #{packageJson},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where package_id = #{packageId}
    </update>

    <delete id="deleteCompetitionCheckDataPackageByPackageId" parameterType="Long">
        delete from competition_check_data_package where package_id = #{packageId}
    </delete>

    <delete id="deleteCompetitionCheckDataPackageByPackageIds" parameterType="String">
        delete from competition_check_data_package where package_id in
        <foreach item="packageId" collection="array" open="(" separator="," close=")">
            #{packageId}
        </foreach>
    </delete>
</mapper>
