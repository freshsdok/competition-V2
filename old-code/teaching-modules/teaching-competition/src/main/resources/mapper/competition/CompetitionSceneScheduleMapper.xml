<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.mapper.CompetitionSceneScheduleMapper">

    <resultMap type="com.teaching.competition.domain.CompetitionSceneSchedule" id="CompetitionSceneScheduleResult">
        <id property="scheduleId" column="schedule_id"/>
        <result property="scheduleName" column="schedule_name"/>
        <result property="competitionSeriesId" column="competition_series_id"/>
        <result property="competitionName" column="competition_name"/>
        <result property="competitionStageId" column="competition_stage_id"/>
        <result property="competitionStageName" column="competition_stage_name"/>
        <result property="competitionTrackId" column="competition_track_id"/>
        <result property="competitionTrackName" column="competition_track_name"/>
        <result property="secondLevelCode" column="second_level_code"/>
