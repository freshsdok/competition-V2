    <sql id="selectAwardDetailsVo">
        select id, award_publicity_id, team_code, team_name, school_name, awards_name, create_by, create_time, update_by, update_time, del_flag from award_details
    </sql>

    <select id="selectAwardDetailsList" parameterType="com.teaching.competition.domain.AwardDetails" resultMap="AwardDetailsResult">
        <include refid="selectAwardDetailsVo"/>
        <where>
            <if test="awardPublicityId != null "> and award_publicity_id = #{awardPublicityId}</if>
            <if test="teamCode != null  and teamCode != ''"> and team_code = #{teamCode}</if>
            <if test="awardsName != null  and awardsName != ''"> and awards_name like concat('%', #{awardsName}, '%')</if>
        </where>
        order by id desc
    </select>

    <select id="selectAwardDetailsById" parameterType="Long" resultMap="AwardDetailsResult">
        <include refid="selectAwardDetailsVo"/>
        where id = #{id}
    </select>

    <select id="selectAwardDetailsSum" parameterType="Long" resultType="Integer">
        select count(1) from award_details
        where del_flag = '0' and award_publicity_id = #{awardPublicityId}
    </select>

