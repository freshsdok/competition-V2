<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.mapper.CompetitionWorkLinkInfoMapper">
    
    <resultMap type="com.teaching.competition.domain.CompetitionWorkLinkInfo" id="CompetitionWorkLinkInfoResult">
        <result property="linkId"    column="link_id"    />
        <result property="linkUrl"    column="link_url"    />
        <result property="linkName"    column="link_name"    />
        <result property="worksId"    column="works_id"    />
        <result property="competitionSeriesId"    column="competition_series_id"    />
        <result property="competitionName"    column="competition_name"    />
        <result property="stageName"    column="stage_name"    />
        <result property="extractionCode"    column="extraction_code"    />
        <result property="extractionCodeTime"    column="extraction_code_time"    />
        <result property="stageId"    column="stage_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectCompetitionWorkLinkInfoVo">
        select link_id, link_url, link_name, works_id, competition_series_id, stage_id, extraction_code,extraction_code_time,create_by, create_time, update_by, update_time, version, del_flag from competition_work_link_info
    </sql>

    <select id="selectCompetitionWorkLinkInfoList" parameterType="com.teaching.competition.domain.CompetitionWorkLinkInfo" resultMap="CompetitionWorkLinkInfoResult">
        select a.link_id, a.link_url, a.link_name, a.works_id, a.competition_series_id, a.stage_id,
        a.extraction_code,a.extraction_code_time,
        (select competition_name from competition_main_info where competition_id =
        (select competition_id from competition_series_info where competition_series_id = a.competition_series_id)) competition_name,
        (select stage_name from competition_stage_config where stage_id = a.stage_id) stage_name,
        a.create_by, a.create_time, a.update_by, a.update_time, a.version, a.del_flag
        from competition_work_link_info a
        <where>  
            <if test="linkUrl != null  and linkUrl != ''"> and a.link_url = #{linkUrl}</if>
            <if test="linkName != null  and linkName != ''"> and a.link_name like concat('%', #{linkName}, '%')</if>
            <if test="worksId != null  and worksId != ''"> and a.works_id = #{worksId}</if>
            <if test="competitionName != null and competitionName != ''">
                and a.competition_series_id in (select b.competition_series_id from competition_main_info i left join
                competition_series_info b on i.competition_id = b.competition_id
                where i.competition_name like concat('%', #{competitionName}, '%'))
            </if>
            <if test="stageId != null  and stageId != ''"> and a.stage_id = #{stageId}</if>
        </where>
    </select>
    
    <select id="selectCompetitionWorkLinkInfoByLinkId" parameterType="Long" resultMap="CompetitionWorkLinkInfoResult">
        <include refid="selectCompetitionWorkLinkInfoVo"/>
        where link_id = #{linkId}
    </select>

    <select id="selectCompetitionWorkLinkInfoByExtractionCode" parameterType="String" resultMap="CompetitionWorkLinkInfoResult">
        <include refid="selectCompetitionWorkLinkInfoVo"/>
        where extraction_code = #{extractionCode}
    </select>

    <insert id="insertCompetitionWorkLinkInfo" parameterType="com.teaching.competition.domain.CompetitionWorkLinkInfo" useGeneratedKeys="true" keyProperty="linkId">
        insert into competition_work_link_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="linkUrl != null">link_url,</if>
            <if test="linkName != null">link_name,</if>
            <if test="worksId != null">works_id,</if>
            <if test="competitionSeriesId != null">competition_series_id,</if>
            <if test="stageId != null">stage_id,</if>
            <if test="extractionCode != null">extraction_code,</if>
            <if test="extractionCodeTime != null">extraction_code_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="linkUrl != null">#{linkUrl},</if>
            <if test="linkName != null">#{linkName},</if>
            <if test="worksId != null">#{worksId},</if>
            <if test="competitionSeriesId != null">#{competitionSeriesId},</if>
            <if test="stageId != null">#{stageId},</if>
            <if test="extractionCode != null">#{extractionCode},</if>
            <if test="extractionCodeTime != null">#{extractionCodeTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateCompetitionWorkLinkInfo" parameterType="com.teaching.competition.domain.CompetitionWorkLinkInfo">
        update competition_work_link_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="linkName != null">link_name = #{linkName},</if>
            <if test="worksId != null">works_id = #{worksId},</if>
            <if test="competitionSeriesId != null">competition_series_id = #{competitionSeriesId},</if>
            <if test="stageId != null">stage_id = #{stageId},</if>
            <if test="extractionCode != null">extraction_code = #{extractionCode},</if>
            <if test="extractionCodeTime != null">extraction_code_time = #{extractionCodeTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            version = version + 1,
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where link_id = #{linkId}
    </update>

    <delete id="deleteCompetitionWorkLinkInfoByLinkId" parameterType="Long">
        delete from competition_work_link_info where link_id = #{linkId}
    </delete>

    <delete id="deleteCompetitionWorkLinkInfoByLinkIds" parameterType="String">
        delete from competition_work_link_info where link_id in 
        <foreach item="linkId" collection="array" open="(" separator="," close=")">
            #{linkId}
        </foreach>
    </delete>
</mapper>