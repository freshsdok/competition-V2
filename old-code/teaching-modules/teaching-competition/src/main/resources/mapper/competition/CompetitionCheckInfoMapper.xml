<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.competition.mapper.CompetitionCheckInfoMapper">

    <resultMap type="CompetitionCheckInfo" id="CompetitionCheckInfoResult">
        <result property="checkItemId"    column="check_item_id"    />
        <result property="checkItemName"    column="check_item_name"    />
        <result property="remark"    column="remark"    />
        <result property="function"    column="function"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectCompetitionCheckInfoVo">
        select check_item_id, check_item_name, remark, `function`, create_by, create_time, update_by, update_time, version, del_flag from competition_check_info
    </sql>

    <select id="selectCompetitionCheckInfoList" parameterType="CompetitionCheckInfo" resultMap="CompetitionCheckInfoResult">
        <include refid="selectCompetitionCheckInfoVo"/>
        <where>
            <if test="checkItemName != null  and checkItemName != ''"> and check_item_name like concat('%', #{checkItemName}, '%')</if>
            <if test="function != null  and function != ''"> and `function` = #{function}</if>
            <if test="version != null "> and version = #{version}</if>
        </where>
    </select>

    <select id="selectCompetitionCheckInfoByCheckItemId" parameterType="Long" resultMap="CompetitionCheckInfoResult">
        <include refid="selectCompetitionCheckInfoVo"/>
        where check_item_id = #{checkItemId}
    </select>

    <select id="selectCompetitionCheckInfoByCheckItemIds" parameterType="java.util.List" resultMap="CompetitionCheckInfoResult">
            <include refid="selectCompetitionCheckInfoVo"/>
            where check_item_id in
            <foreach item="checkItemId" collection="list" open="(" separator="," close=")">
                    #{checkItemId}
            </foreach>
    </select>

    <insert id="insertCompetitionCheckInfo" parameterType="CompetitionCheckInfo" useGeneratedKeys="true" keyProperty="checkItemId">
        insert into competition_check_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="checkItemName != null">check_item_name,</if>
            <if test="remark != null">remark,</if>
            <if test="function != null and function != ''">`function`,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="checkItemName != null">#{checkItemName},</if>
            <if test="remark != null">#{remark},</if>
            <if test="function != null and function != ''">#{function},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateCompetitionCheckInfo" parameterType="CompetitionCheckInfo">
        update competition_check_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="checkItemName != null">check_item_name = #{checkItemName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="function != null and function != ''">`function` = #{function},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where check_item_id = #{checkItemId}
    </update>

    <delete id="deleteCompetitionCheckInfoByCheckItemId" parameterType="Long">
        delete from competition_check_info where check_item_id = #{checkItemId}
    </delete>

    <delete id="deleteCompetitionCheckInfoByCheckItemIds" parameterType="String">
        delete from competition_check_info where check_item_id in
        <foreach item="checkItemId" collection="array" open="(" separator="," close=")">
            #{checkItemId}
        </foreach>
    </delete>
</mapper>
