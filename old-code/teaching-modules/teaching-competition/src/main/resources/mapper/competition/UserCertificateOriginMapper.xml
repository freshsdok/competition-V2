    <delete id="deleteUserCertificateOriginById" parameterType="com.teaching.system.api.domain.UserCertificateOrigin">
        update user_certificate_origin set del_flag = '1' where cert_id = #{certId} and user_id = #{userId} and competition_series_id = #{competitionSeriesId}
    </delete>

    <delete id="deleteUserCertificateOriginByIds" parameterType="Long[]">
        update user_certificate_origin set del_flag = '1' where cert_id in
        <foreach item="certId" collection="array" open="(" separator="," close=")">
            #{certId}
        </foreach>
    </delete>
