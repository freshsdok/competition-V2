            </if>
            <if test="trainingProgramId != null">
                and training_program_id = #{trainingProgramId}
            </if>
            <if test="certStatus != null and certStatus != ''">
                and cert_status = #{certStatus}
            </if>
            <if test="teamCode != null and teamCode != ''">
                and team_code = #{teamCode}
            </if>
            <if test="awardsName != null and awardsName != ''">
                and awards_name = #{awardsName}
            </if>
            <if test="year != null and year != ''">
                and year = #{year}
            </if>
            <if test="orgCode != null and orgCode != ''">
                and org_code = #{orgCode}
            </if>
            <if test="player != null and player != ''">
                and player like concat('%', #{player}, '%')
            </if>
            <if test="userName != null and userName != ''">
                and user_name like concat('%', #{userName}, '%')
            </if>
            <if test="idCard != null and idCard != ''">
                and id_card = #{idCard}
            </if>
            <if test="guideTeacher != null and guideTeacher != ''">
                and guide_teacher like concat('%', #{guideTeacher}, '%')
            </if>
            <if test="schoolName != null and schoolName != ''">
                and school_name like concat('%', #{schoolName}, '%')
            </if>
        </where>
    </select>

