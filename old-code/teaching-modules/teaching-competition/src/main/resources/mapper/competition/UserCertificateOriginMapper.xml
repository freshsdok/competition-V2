    <sql id="selectUserCertificateOriginVo">
        select cert_id, cert_code, cert_name, cert_url, issuance_date, cert_period, acquire_way, competition_series_id,
        competition_stage_id, competition_track_id, second_level_code,competition_name,course_id,
        training_program_id, cert_exchange_id, second_level_name,
        cert_config_id, cert_status, team_code, awards_name, awards_name_desc, year, org_code, user_id, player, user_name,
        id_card, guide_teacher, school, school_name, year_limit, create_by, create_time, update_by, update_time, del_flag, version
        from user_certificate_origin
    </sql>

    <select id="selectUserCertificateOriginById" parameterType="Long" resultMap="UserCertificateOriginResult">
        <include refid="selectUserCertificateOriginVo" />
        where cert_id = #{certId}
    </select>

    <select id="selectUserCertificateOriginByStageId" parameterType="com.teaching.system.api.domain.UserCertificateOrigin" resultMap="UserCertificateOriginResult">
        <include refid="selectUserCertificateOriginVo" />
        where del_flag = '0'
        <if test="competitionStageId!=null and competitionStageId!=''">
            and competition_stage_id = #{competitionStageId}
        </if>
        <if test="competitionSeriesId!=null and competitionSeriesId!=''">
            and competition_series_id = #{competitionSeriesId}
        </if>
        <if test="awardsName!=null and awardsName!=''">
            and awards_name = #{awardsName}
        </if>
        <if test="userName!=null and userName!=''">
            and FIND_IN_SET(#{userName},player)
        </if>
    </select>

    <select id="selectUserCertificateOriginByCetCode" parameterType="List" resultMap="UserCertificateOriginResult">
        <include refid="selectUserCertificateOriginVo" />
        where cert_code in
        <foreach item="item" collection="certCodeList" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>

    <select id="selectUserCertificateOriginByIdCard" parameterType="Object" resultMap="UserCertificateOriginResult">
        <include refid="selectUserCertificateOriginVo" />
        where id_card = #{idCard} and cert_id = #{certId}
    </select>

    <!--
      下载授权只认报名表中的 leader_teacher_id。只取已缴费团队，并按证书编号去重；
      教师证书和单位证书没有有效 team_code，因此不会进入负责人学生证书压缩包。
    -->
    <select id="selectGuidedCertificateCodes" resultType="java.lang.String">
        SELECT uco.cert_code
        FROM user_certificate_origin uco
        WHERE uco.del_flag = '0'
          AND uco.cert_code IS NOT NULL
          AND uco.cert_code != ''
          AND uco.team_code IS NOT NULL
          AND uco.team_code != ''
          AND EXISTS (
              SELECT 1
              FROM competition_apply_info cai
              WHERE cai.competition_series_id = uco.competition_series_id
                AND cai.team_code = uco.team_code
                AND cai.leader_teacher_id = #{userId}
                AND cai.pay_status = 'paid'
                AND cai.del_flag = '0'
          )
        GROUP BY uco.cert_code
        ORDER BY MAX(uco.competition_series_id), uco.cert_code
    </select>

    <select id="countGuidedCertificateTeams" resultType="long">
        SELECT COUNT(*)
        FROM (
            SELECT uco.competition_series_id, uco.team_code
            FROM user_certificate_origin uco
            WHERE uco.del_flag = '0'
              AND uco.cert_code IS NOT NULL
              AND uco.cert_code != ''
              AND uco.team_code IS NOT NULL
              AND uco.team_code != ''
              AND EXISTS (
                  SELECT 1
                  FROM competition_apply_info cai
                  WHERE cai.competition_series_id = uco.competition_series_id
                    AND cai.team_code = uco.team_code
                    AND cai.leader_teacher_id = #{userId}
                    AND cai.pay_status = 'paid'
                    AND cai.del_flag = '0'
              )
            GROUP BY uco.competition_series_id, uco.team_code
        ) guided_team
    </select>

    <select id="selectUserCertificateOriginList" parameterType="com.teaching.system.api.domain.UserCertificateOrigin" resultMap="UserCertificateOriginResult">
        <include refid="selectUserCertificateOriginVo"/>
        <where>
            <if test="certCode != null and certCode != ''">
                and cert_code = #{certCode}
            </if>
            <if test="certName != null and certName != ''">
                and cert_name like concat('%', #{certName}, '%')
            </if>
            <if test="acquireWay != null and acquireWay != ''">
                and acquire_way = #{acquireWay}
            </if>
            <if test="competitionSeriesId != null">
