        <result property="slotDurationMinutes" column="slot_duration_minutes"/>
        <result property="sharedOccupancy" column="shared_occupancy"/>
        <result property="needOpsConfirm" column="need_ops_confirm"/>
        <result property="opsContactName" column="ops_contact_name"/>
        <result property="opsContactPhone" column="ops_contact_phone"/>
        <result property="bookingStatus" column="booking_status"/>
