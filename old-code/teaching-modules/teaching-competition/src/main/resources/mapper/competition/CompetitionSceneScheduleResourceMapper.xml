    <resultMap type="com.teaching.competition.domain.CompetitionSceneScheduleResourceVO" id="CompetitionSceneScheduleResourceVOResult">
        <id property="scheduleResourceId" column="schedule_resource_id"/>
        <result property="scheduleId" column="schedule_id"/>
        <result property="resourceId" column="resource_id"/>
        <result property="eventId" column="event_id"/>
        <result property="deploymentLocation" column="deployment_location"/>
        <result property="deployedDeviceCount" column="deployed_device_count"/>
        <result property="workstationsPerDevice" column="workstations_per_device"/>
