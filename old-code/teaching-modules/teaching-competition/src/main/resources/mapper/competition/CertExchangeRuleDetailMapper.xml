    <delete id="deleteCertExchangeRuleDetailByRulerId" parameterType="Long">
        update cert_exchange_rule_detail set del_flag = '1' where rule_id = #{ruleId}
    </delete>

    <delete id="deleteCertExchangeRuleDetailById" parameterType="Long">
        update cert_exchange_rule_detail set del_flag = '1' where detail_id = #{detailId}
    </delete>

    <delete id="deleteCertExchangeRuleDetailByIds" parameterType="Long[]">
        update cert_exchange_rule_detail set del_flag = '1' where detail_id in
        <foreach item="detailId" collection="array" open="(" separator="," close=")">
