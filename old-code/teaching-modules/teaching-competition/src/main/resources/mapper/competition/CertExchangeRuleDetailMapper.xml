        <result property="originCertCode" column="origin_cert_code" />
        <result property="originCertName" column="origin_cert_name" />
        <result property="originCertScore" column="origin_cert_score" />
        <result property="targetCertConfigId" column="target_cert_config_id" />
        <result property="targetCertCode" column="target_cert_code" />
