    <sql id="selectCertExchangeRuleDetailVo">
        select detail_id, rule_id, origin_cert_config_id, origin_cert_code, origin_cert_name, origin_cert_score, target_cert_config_id, target_cert_code, target_cert_name, target_cert_score, rule_status, year, origin_year_limit, sort, create_by, create_time, update_by, update_time, del_flag, version from cert_exchange_rule_detail
    </sql>

    <select id="selectCertExchangeRuleDetailById" parameterType="Long" resultMap="CertExchangeRuleDetailResult">
        <include refid="selectCertExchangeRuleDetailVo" />
        where detail_id = #{detailId}
    </select>

    <select id="selectCertExchangeRuleDetailList" parameterType="com.teaching.competition.domain.CertExchangeRuleDetail" resultMap="CertExchangeRuleDetailResult">
        <include refid="selectCertExchangeRuleDetailVo" />
        <where>
            <if test="ruleId != null">
                and rule_id = #{ruleId}
            </if>
            <if test="originCertCode != null and originCertCode != ''">
                and origin_cert_code = #{originCertCode}
            </if>
            <if test="originCertName != null and originCertName != ''">
                and origin_cert_name like concat('%', #{originCertName}, '%')
            </if>
            <if test="targetCertConfigId != null">
                and target_cert_config_id = #{targetCertConfigId}
            </if>
            <if test="targetCertName != null and targetCertName != ''">
                and target_cert_name like concat('%', #{targetCertName}, '%')
            </if>
            <if test="ruleStatus != null and ruleStatus != ''">
                and rule_status = #{ruleStatus}
            </if>
            <if test="year != null and year != ''">
                and year = #{year}
            </if>
            <if test="delFlag != null and delFlag != ''">
                and del_flag = #{delFlag}
            </if>
        </where>
    </select>

    <insert id="insertCertExchangeRuleDetail" parameterType="com.teaching.competition.domain.CertExchangeRuleDetail" useGeneratedKeys="true" keyProperty="detailId">
        insert into cert_exchange_rule_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ruleId != null">rule_id,</if>
            <if test="originCertConfigId != null">origin_cert_config_id,</if>
            <if test="originCertCode != null">origin_cert_code,</if>
            <if test="originCertName != null">origin_cert_name,</if>
            <if test="originCertScore != null">origin_cert_score,</if>
            <if test="targetCertConfigId != null">target_cert_config_id,</if>
            <if test="targetCertCode != null">target_cert_code,</if>
            <if test="targetCertName != null">target_cert_name,</if>
            <if test="targetCertScore != null">target_cert_score,</if>
            <if test="ruleStatus != null">rule_status,</if>
            <if test="year != null">year,</if>
            <if test="originYearLimit != null">origin_year_limit,</if>
            <if test="sort != null">sort,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="version != null">version,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ruleId != null">#{ruleId},</if>
            <if test="originCertConfigId != null">#{originCertConfigId},</if>
            <if test="originCertCode != null">#{originCertCode},</if>
