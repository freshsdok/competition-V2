    <insert id="batchInsertCertExchangeRuleDetail" parameterType="java.util.List">
        insert into cert_exchange_rule_detail (rule_id, origin_cert_config_id, origin_cert_code, origin_cert_name, origin_cert_score, target_cert_config_id, target_cert_code,
        target_cert_name, target_cert_score, rule_status, year, origin_year_limit, sort, create_by, create_time, update_by, update_time)
        values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.ruleId}, #{item.originCertConfigId}, #{item.originCertCode}, #{item.originCertName}, #{item.originCertScore}, #{item.targetCertConfigId}, #{item.targetCertCode},
            #{item.targetCertName}, #{item.targetCertScore}, #{item.ruleStatus}, #{item.year}, #{item.originYearLimit}, #{item.sort}, #{item.createBy},
            now(), #{item.updateBy}, #{item.updateTime})
        </foreach>
    </insert>

    <update id="updateCertExchangeRuleDetail" parameterType="com.teaching.competition.domain.CertExchangeRuleDetail">
        update cert_exchange_rule_detail
        <set>
            <if test="ruleId != null">rule_id = #{ruleId},</if>
            <if test="originCertConfigId != null">origin_cert_config_id = #{originCertConfigId},</if>
            <if test="originCertCode != null">origin_cert_code = #{originCertCode},</if>
