<mapper namespace="com.teaching.competition.mapper.CertExchangeRuleDetailMapper">
    <resultMap type="com.teaching.competition.domain.CertExchangeRuleDetail" id="CertExchangeRuleDetailResult">
        <id property="detailId" column="detail_id" />
