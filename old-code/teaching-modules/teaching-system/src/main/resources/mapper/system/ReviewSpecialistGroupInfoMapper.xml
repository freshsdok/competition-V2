<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.system.mapper.ReviewSpecialistGroupInfoMapper">

    <resultMap type="com.teaching.system.domain.ReviewSpecialistGroupInfo" id="ReviewSpecialistGroupInfoResult">
        <result property="groupId" column="group_id"/>
        <result property="groupName" column="group_name"/>
        <result property="allotStatus" column="allot_status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="version" column="version"/>
        <result property="delFlag" column="del_flag"/>
        <collection property="reviewGroupSpecialistRelationList"
                    ofType="com.teaching.system.domain.ReviewGroupSpecialistRelation"
                    column="group_id"
                    select="com.teaching.system.mapper.ReviewGroupSpecialistRelationMapper.selectReviewGroupSpecialistRelationByGroupId"/>
    </resultMap>

    <sql id="selectReviewSpecialistGroupInfoVo">
        select group_id, group_name, allot_status, create_by, create_time, update_by, update_time, version, del_flag
        from review_specialist_group_info
    </sql>

    <select id="selectReviewSpecialistGroupInfoList" parameterType="com.teaching.system.domain.ReviewSpecialistGroupInfo"
            resultMap="ReviewSpecialistGroupInfoResult">
        <include refid="selectReviewSpecialistGroupInfoVo"/>
        <where>
            del_flag = '0'
            <if test="groupName != null and groupName != ''">
                and group_name like concat('%', #{groupName}, '%')
            </if>
            <if test="allotStatus != null and allotStatus != ''">
                and allot_status = #{allotStatus}
            </if>
        </where>
    </select>

    <select id="selectReviewSpecialistGroupInfoByGroupId" parameterType="Long"
            resultMap="ReviewSpecialistGroupInfoResult">
        <include refid="selectReviewSpecialistGroupInfoVo"/>
        where group_id = #{groupId} and del_flag = '0'
    </select>

    <insert id="insertReviewSpecialistGroupInfo" parameterType="com.teaching.system.domain.ReviewSpecialistGroupInfo"
            useGeneratedKeys="true" keyProperty="groupId">
        insert into review_specialist_group_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupName != null">group_name,</if>
            <if test="allotStatus != null">allot_status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupName != null">#{groupName},</if>
            <if test="allotStatus != null">#{allotStatus},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateReviewSpecialistGroupInfo" parameterType="com.teaching.system.domain.ReviewSpecialistGroupInfo">
        update review_specialist_group_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="allotStatus != null">allot_status = #{allotStatus},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where group_id = #{groupId}
    </update>

    <delete id="deleteReviewSpecialistGroupInfoByGroupId" parameterType="Long">
        update review_specialist_group_info set del_flag = '2' where group_id = #{groupId}
    </delete>

    <delete id="deleteReviewSpecialistGroupInfoByGroupIds">
        update review_specialist_group_info set del_flag = '1' where group_id in
        <foreach collection="array" item="groupId" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>

    <delete id="deleteReviewGroupSpecialistRelationByGroupIds">
        update review_group_specialist_relation set del_flag = '1' where group_id in
        <foreach collection="array" item="groupId" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>

    <insert id="batchReviewGroupSpecialistRelation">
        insert into review_group_specialist_relation (group_id, user_id, create_by, create_time, update_by, update_time) values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.groupId}, #{item.userId}, #{item.createBy}, now(), #{item.updateBy}, #{item.updateTime})
        </foreach>
    </insert>
</mapper>
