<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.system.mapper.ReviewTaskAllotGroupMapper">

    <resultMap type="com.teaching.system.domain.ReviewTaskAllotGroup" id="ReviewTaskAllotGroupResult">
        <result property="reviewGroupId" column="review_group_id"/>
        <result property="allotGroupName" column="allot_group_name"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="version" column="version"/>
        <result property="delFlag" column="del_flag"/>
        <collection property="reviewTaskAllotGroupRelationList"
                    ofType="com.teaching.system.domain.ReviewTaskAllotGroupRelation"
                    column="review_group_id"
                    select="com.teaching.system.mapper.ReviewTaskAllotGroupRelationMapper.selectReviewTaskAllotGroupRelationByReviewGroupId"/>
    </resultMap>

    <sql id="selectReviewTaskAllotGroupVo">
        select review_group_id, allot_group_name, create_by, create_time, update_by, update_time, version, del_flag
        from review_task_allot_group
    </sql>

    <select id="selectReviewTaskAllotGroupList" parameterType="com.teaching.system.domain.ReviewTaskAllotGroup"
            resultMap="ReviewTaskAllotGroupResult">
        <include refid="selectReviewTaskAllotGroupVo"/>
        <where>
            del_flag = '0'
            <if test="allotGroupName != null and allotGroupName != ''">
                and allot_group_name like concat('%', #{allotGroupName}, '%')
            </if>
        </where>
    </select>

    <select id="selectReviewTaskAllotGroupByReviewGroupId" parameterType="Long"
            resultMap="ReviewTaskAllotGroupResult">
        <include refid="selectReviewTaskAllotGroupVo"/>
        where review_group_id = #{reviewGroupId} and del_flag = '0'
    </select>

    <insert id="insertReviewTaskAllotGroup" parameterType="com.teaching.system.domain.ReviewTaskAllotGroup"
            useGeneratedKeys="true" keyProperty="reviewGroupId">
        insert into review_task_allot_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="allotGroupName != null">allot_group_name,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="allotGroupName != null">#{allotGroupName},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateReviewTaskAllotGroup" parameterType="com.teaching.system.domain.ReviewTaskAllotGroup">
        update review_task_allot_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="allotGroupName != null">allot_group_name = #{allotGroupName},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where review_group_id = #{reviewGroupId}
    </update>

    <delete id="deleteReviewTaskAllotGroupByReviewGroupId" parameterType="Long">
        update review_task_allot_group set del_flag = '1' where review_group_id = #{reviewGroupId}
    </delete>

    <delete id="deleteReviewTaskAllotGroupByReviewGroupIds">
        update review_task_allot_group set del_flag = '2' where review_group_id in
        <foreach collection="array" item="reviewGroupId" open="(" separator="," close=")">
            #{reviewGroupId}
        </foreach>
    </delete>

    <delete id="deleteReviewTaskAllotGroupRelationByReviewGroupIds">
        update review_task_allot_group_relation set del_flag = '1' where review_group_id in
        <foreach collection="array" item="reviewGroupId" open="(" separator="," close=")">
            #{reviewGroupId}
        </foreach>
    </delete>

    <insert id="batchReviewTaskAllotGroupRelation">
        insert into review_task_allot_group_relation (review_group_id, review_id, create_by, create_time, update_by,
        update_time) values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.reviewGroupId}, #{item.reviewId}, #{item.createBy}, now(), #{item.updateBy},
            #{item.updateTime})
        </foreach>
    </insert>
</mapper>
