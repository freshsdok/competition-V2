<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.system.mapper.SysUserOrgMapper">
    
    <resultMap type="com.teaching.system.domain.SysUserOrg" id="SysUserOrgResult">
        <result property="relaId"    column="rela_id"    />
        <result property="userId"    column="user_id"    />
        <result property="orgId"    column="org_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectSysUserOrgVo">
        select rela_id, user_id, org_id, create_by, create_time, update_by, update_time, version, del_flag from sys_user_org
    </sql>

    <select id="selectSysUserOrgList" parameterType="com.teaching.system.domain.SysUserOrg" resultMap="SysUserOrgResult">
        <include refid="selectSysUserOrgVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="orgId != null "> and org_id = #{orgId}</if>
            <if test="version != null "> and version = #{version}</if>
        </where>
    </select>
    
    <select id="selectSysUserOrgByRelaId" parameterType="Long" resultMap="SysUserOrgResult">
        <include refid="selectSysUserOrgVo"/>
        where rela_id = #{relaId}
    </select>

    <insert id="insertSysUserOrg" parameterType="com.teaching.system.domain.SysUserOrg">
        insert into sys_user_org
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="orgId != null">org_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="orgId != null">#{orgId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <insert id="batchUserOrg">
        insert into sys_user_post(user_id, org_id,create_by,create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.userId},#{item.orgId},#{item.createBy},sysdate())
        </foreach>
    </insert>

    <update id="updateSysUserOrg" parameterType="com.teaching.system.domain.SysUserOrg">
        update sys_user_org
        <trim prefix="SET" suffixOverrides=",">
            <if test="orgId != null">org_id = #{orgId},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            sysdate(),
            version = version+1,
        </trim>
        where user_id = #{userId}
    </update>

    <delete id="deleteSysUserOrgByUserId" parameterType="Long">
        delete from sys_user_org where user_id = #{userId}
    </delete>

    <delete id="deleteSysUserOrgByUserIds" parameterType="String">
        delete from sys_user_org where user_id in
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{relaId}
        </foreach>
    </delete>
</mapper>