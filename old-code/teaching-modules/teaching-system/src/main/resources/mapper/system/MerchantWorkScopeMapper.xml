<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.system.mapper.MerchantWorkScopeMapper">
    
    <resultMap type="com.teaching.system.domain.MerchantWorkScope" id="MerchantWorkScopeResult">
        <result property="id"    column="id"    />
        <result property="configId"    column="config_id"    />
        <result property="categoryCode"    column="category_code"    />
        <result property="categoryName"    column="category_name"    />
        <result property="eventId"    column="event_id"    />
        <result property="eventName"    column="event_name"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="userId"    column="user_id"    />
        <result property="orgId"    column="org_id"    />
    </resultMap>

    <sql id="selectMerchantWorkScopeVo">
        select id, config_id, category_code, category_name, event_id, event_name, remark, create_by, create_time, update_by, update_time, version, del_flag, user_id, org_id from merchant_work_scope
    </sql>

    <select id="selectMerchantWorkScopeList" parameterType="com.teaching.system.domain.MerchantWorkScope" resultMap="MerchantWorkScopeResult">
        <include refid="selectMerchantWorkScopeVo"/>
        <where>
            del_flag = 0
            <if test="configId != null "> and config_id = #{configId}</if>
            <if test="categoryCode != null  and categoryCode != ''"> and category_code = #{categoryCode}</if>
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="eventId != null "> and event_id = #{eventId}</if>
            <if test="eventName != null  and eventName != ''"> and event_name like concat('%', #{eventName}, '%')</if>
            <if test="version != null "> and version = #{version}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="orgId != null "> and org_id = #{orgId}</if>
        </where>
    </select>
    
    <select id="selectMerchantWorkScopeById" parameterType="Long" resultMap="MerchantWorkScopeResult">
        <include refid="selectMerchantWorkScopeVo"/>
        where id = #{id} and del_flag = 0
    </select>
    <select id="selectListByConfigId" resultMap="MerchantWorkScopeResult">
        <include refid="selectMerchantWorkScopeVo"/>
        where config_id = #{configId} and del_flag = 0
    </select>

    <select id="selectListByConfigIdAndCategory" resultMap="MerchantWorkScopeResult">
        <include refid="selectMerchantWorkScopeVo"/>
        where config_id = #{configId} and category_code = #{categoryCode} and del_flag = 0
    </select>

    <insert id="insertMerchantWorkScope" parameterType="com.teaching.system.domain.MerchantWorkScope" useGeneratedKeys="true" keyProperty="id">
        insert into merchant_work_scope
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configId != null">config_id,</if>
            <if test="categoryCode != null">category_code,</if>
            <if test="categoryName != null">category_name,</if>
            <if test="eventId != null">event_id,</if>
            <if test="eventName != null">event_name,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="userId != null">user_id,</if>
            <if test="orgId != null">org_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configId != null">#{configId},</if>
            <if test="categoryCode != null">#{categoryCode},</if>
            <if test="categoryName != null">#{categoryName},</if>
            <if test="eventId != null">#{eventId},</if>
            <if test="eventName != null">#{eventName},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="userId != null">#{userId},</if>
            <if test="orgId != null">#{orgId},</if>
         </trim>
    </insert>
    <insert id="insertMerchantWorkScopeBatch">
        insert into merchant_work_scope (config_id, category_code, category_name, event_id, event_name, remark, create_by, create_time, update_by, update_time, version, del_flag, user_id, org_id)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.configId}, #{item.categoryCode}, #{item.categoryName}, #{item.eventId}, #{item.eventName}, #{item.remark}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.version}, #{item.delFlag}, #{item.userId}, #{item.orgId})
        </foreach>
    </insert>

    <update id="updateMerchantWorkScope" parameterType="com.teaching.system.domain.MerchantWorkScope">
        update merchant_work_scope
        <trim prefix="SET" suffixOverrides=",">
            <if test="configId != null">config_id = #{configId},</if>
            <if test="categoryCode != null">category_code = #{categoryCode},</if>
            <if test="categoryName != null">category_name = #{categoryName},</if>
            <if test="eventId != null">event_id = #{eventId},</if>
            <if test="eventName != null">event_name = #{eventName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="orgId != null">org_id = #{orgId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMerchantWorkScopeById" parameterType="Long">
        delete from merchant_work_scope where id = #{id} and del_flag = 0
    </delete>

    <update id="deleteByConfigId">
        update merchant_work_scope set del_flag = 1 where config_id = #{configId} and del_flag = 0
    </update>

    <update id="deleteMerchantWorkScopeByIds" parameterType="String">
        update merchant_work_scope set del_flag = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
         and del_flag = 0
    </update>
</mapper>