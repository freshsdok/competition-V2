    <sql id="selectMerchantParamConfigVo">
        select id, mer_name, mer_id, fee_user_id, term_id, pay_valid_time, pay_app_id, pay_app_secret, pay_private_key, pay_public_key, invoice_app_key, invoice_app_secret,invoice_access_token, tax_num, extension, tax_rate, clerk, checker, bank, account, address, work_scope, invoice_content, status, remark, create_by, create_time, update_by, update_time, version, del_flag, user_id, org_id from merchant_param_config
    </sql>

    <select id="selectMerchantParamConfigList" parameterType="com.teaching.system.domain.MerchantParamConfig" resultMap="MerchantParamConfigResult">
        <include refid="selectMerchantParamConfigVo"/>
        <where>
            del_flag = 0  <!-- 添加逻辑删除标志 -->
            <if test="merName != null  and merName != ''"> and mer_name like concat('%', #{merName}, '%')</if>
            <if test="merId != null  and merId != ''"> and mer_id = #{merId}</if>
            <if test="feeUserId != null  and feeUserId != ''"> and fee_user_id = #{feeUserId}</if>
            <if test="termId != null  and termId != ''"> and term_id = #{termId}</if>
            <if test="payValidTime != null "> and pay_valid_time = #{payValidTime}</if>
            <if test="payAppId != null  and payAppId != ''"> and pay_app_id = #{payAppId}</if>
            <if test="payAppSecret != null  and payAppSecret != ''"> and pay_app_secret = #{payAppSecret}</if>
            <if test="payPrivateKey != null  and payPrivateKey != ''"> and pay_private_key = #{payPrivateKey}</if>
            <if test="payPublicKey != null  and payPublicKey != ''"> and pay_public_key = #{payPublicKey}</if>
            <if test="invoiceAppKey != null  and invoiceAppKey != ''"> and invoice_app_key = #{invoiceAppKey}</if>
            <if test="invoiceAppSecret != null  and invoiceAppSecret != ''"> and invoice_app_secret = #{invoiceAppSecret}</if>
            <if test="invoiceAccessToken != null  and invoiceAccessToken != ''"> and invoice_access_token = #{invoiceAccessToken}</if>
            <if test="taxNum != null  and taxNum != ''"> and tax_num = #{taxNum}</if>
