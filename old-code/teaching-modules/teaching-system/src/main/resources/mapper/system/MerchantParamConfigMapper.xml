            <if test="bank != null  and bank != ''"> and bank = #{bank}</if>
            <if test="account != null  and account != ''"> and account = #{account}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="workScope != null  and workScope != ''"> and work_scope = #{workScope}</if>
            <if test="invoiceContent != null  and invoiceContent != ''"> and invoice_content = #{invoiceContent}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="version != null "> and version = #{version}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="orgId != null "> and org_id = #{orgId}</if>
        </where>
    </select>
    
    <select id="selectMerchantParamConfigById" parameterType="Long" resultMap="MerchantParamConfigResult">
        <include refid="selectMerchantParamConfigVo"/>
        where id = #{id} and del_flag = 0
    </select>
    <select id="selectWorkingConfigList" resultMap="MerchantParamConfigResult">
        <include refid="selectMerchantParamConfigVo"/>
        where del_flag = 0 and status = 1
        order by create_time desc
    </select>
    <select id="selectMerchantParamConfigByMerId" resultMap="MerchantParamConfigResult">
        <include refid="selectMerchantParamConfigVo"/>
        where mer_id = #{merId} and del_flag = 0
    </select>
    <select id="selectMerchantParamConfigByTaxNum" resultMap="MerchantParamConfigResult">
        <include refid="selectMerchantParamConfigVo"/>
