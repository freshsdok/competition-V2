<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teaching.system.mapper.OrderStatementRecordMapper">
    
    <resultMap type="com.teaching.system.domain.OrderStatementRecord" id="OrderStatementRecordResult">
        <result property="id"    column="id"    />
        <result property="billDate"    column="bill_date"    />
        <result property="statementFileName"    column="statement_file_name"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderType"    column="order_type"    />
        <result property="amount"    column="amount"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="orgId"    column="org_id"    />
    </resultMap>

    <sql id="selectOrderStatementRecordVo">
        select id, bill_date, statement_file_name, order_id, order_type, amount, status, remark, create_by, create_time, update_by, update_time, version, del_flag, org_id from order_statement_record
    </sql>

    <select id="selectOrderStatementRecordList" parameterType="com.teaching.system.domain.OrderStatementRecord" resultMap="OrderStatementRecordResult">
        <include refid="selectOrderStatementRecordVo"/>
        <where>  
            <if test="billDate != null "> and bill_date = #{billDate}</if>
            <if test="statementFileName != null  and statementFileName != ''"> and statement_file_name like concat('%', #{statementFileName}, '%')</if>
            <if test="orderId != null  and orderId != ''"> and order_id = #{orderId}</if>
            <if test="orderType != null  and orderType != ''"> and order_type = #{orderType}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="version != null "> and version = #{version}</if>
            <if test="orgId != null "> and org_id = #{orgId}</if>
        </where>
    </select>
    
    <select id="selectOrderStatementRecordById" parameterType="Long" resultMap="OrderStatementRecordResult">
        <include refid="selectOrderStatementRecordVo"/>
        where id = #{id}
    </select>
    <select id="selectOrderStatementRecordByBillDate">
        select count(*) from order_statement_record osr where osr.statement_file_name = concat(#{billDate},".xlsx")
    </select>

    <insert id="insertOrderStatementRecord" parameterType="com.teaching.system.domain.OrderStatementRecord" useGeneratedKeys="true" keyProperty="id">
        insert into order_statement_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="billDate != null">bill_date,</if>
            <if test="statementFileName != null">statement_file_name,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderType != null">order_type,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="version != null">version,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="orgId != null">org_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="billDate != null">#{billDate},</if>
            <if test="statementFileName != null">#{statementFileName},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderType != null">#{orderType},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="version != null">#{version},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="orgId != null">#{orgId},</if>
         </trim>
    </insert>

    <update id="updateOrderStatementRecord" parameterType="com.teaching.system.domain.OrderStatementRecord">
        update order_statement_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="billDate != null">bill_date = #{billDate},</if>
            <if test="statementFileName != null">statement_file_name = #{statementFileName},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderType != null">order_type = #{orderType},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="orgId != null">org_id = #{orgId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderStatementRecordById" parameterType="Long">
        delete from order_statement_record where id = #{id}
    </delete>

    <delete id="deleteOrderStatementRecordByIds" parameterType="String">
        delete from order_statement_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>