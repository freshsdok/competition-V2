    <delete id="deleteWxQcCodeConfigByCodeConfigId" parameterType="Long">
        update wx_qc_code_config
        set del_flag = '2'
        where code_config_id = #{codeConfigId}
    </delete>

    <delete id="deleteWxQcCodeConfigByCodeConfigIds">
        update wx_qc_code_config
        set del_flag = '2'
        where code_config_id in
        <foreach collection="array" item="codeConfigId" open="(" separator="," close=")">
            #{codeConfigId}
        </foreach>
    </delete>
