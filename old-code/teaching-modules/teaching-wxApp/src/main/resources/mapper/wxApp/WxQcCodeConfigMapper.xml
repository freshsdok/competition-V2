    <sql id="selectWxQcCodeConfigVo">
        select code_config_id,
               code_config_name,
               competition_series_id,
               user_group_ids,
               success_hint_title,
               success_hint_desc,
               examination_hall_ruler,
               examination_hall_promise,
               improper_title,
               improper_desc,
               create_by,
               create_time,
               update_by,
               update_time,
               remark,
               version,
               del_flag,
               not_me_msg
        from wx_qc_code_config
    </sql>
    <sql id="selectWxQcCodeConfigInfo">
        select cc.code_config_id,
               cc.code_config_name,
               cc.competition_series_id,
               cc.user_group_ids,
               cc.success_hint_title,
               cc.success_hint_desc,
               cc.examination_hall_ruler,
               cc.examination_hall_promise,
               cc.improper_title,
               cc.improper_desc,
               cc.create_by,
               cc.create_time,
               cc.update_by,
               cc.update_time,
               cc.remark,
               cc.version,
               cc.del_flag,
               cc.not_me_msg,
                mi.competition_name,
                si.competition_series_name,si.check_status,si.competition_start_time,si.competition_end_time
        from wx_qc_code_config cc
                 LEFT JOIN competition_series_info si on si.competition_series_id = cc.competition_series_id AND si.del_flag = '0'
                 LEFT JOIN competition_main_info mi on mi.competition_id =si.competition_id AND mi.del_flag ='0'
    </sql>

    <select id="selectWxQcCodeConfigList" parameterType="com.teaching.wxApp.domain.WxQcCodeConfig"
            resultMap="WxQcCodeConfigResult">
        <include refid="selectWxQcCodeConfigInfo"/>
        <where>
            and cc.del_flag = '0'
            <if test="codeConfigName != null and codeConfigName != ''">
                and cc.code_config_name like concat('%', #{codeConfigName}, '%')
            </if>
            <if test="competitionSeriesId != null">
                and cc.competition_series_id = #{competitionSeriesId}
            </if>
            <if test="userGroupIds != null and userGroupIds != ''">
                and cc.user_group_ids = #{userGroupIds}
            </if>
            <if test="successHintTitle != null and successHintTitle != ''">
                and cc.success_hint_title = #{successHintTitle}
            </if>
            <if test="successHintDesc != null and successHintDesc != ''">
                and cc.success_hint_desc = #{successHintDesc}
            </if>
            <if test="examinationHallRuler != null and examinationHallRuler != ''">
                and cc.examination_hall_ruler = #{examinationHallRuler}
            </if>
            <if test="examinationHallPromise != null and examinationHallPromise != ''">
                and cc.examination_hall_promise = #{examinationHallPromise}
            </if>
            <if test="improperTitle != null and improperTitle != ''">
                and cc.improper_title = #{improperTitle}
            </if>
            <if test="improperDesc != null and improperDesc != ''">
                and cc.improper_desc = #{improperDesc}
            </if>
            <if test="version != null">
                and cc.version = #{version}
            </if>
        </where>
        order by cc.create_time desc
    </select>


    <select id="selectWxQcCodeConfigPcList" parameterType="com.teaching.wxApp.domain.WxQcCodeConfig"
            resultMap="WxQcCodeConfigResult">
        <include refid="selectWxQcCodeConfigInfo"/>
        <where>
            and cc.del_flag = '0'
            <if test="codeConfigName != null and codeConfigName != ''">
                and cc.code_config_name like concat('%', #{codeConfigName}, '%')
            </if>
            <if test="competitionSeriesId != null">
                and cc.competition_series_id = #{competitionSeriesId}
            </if>
            <if test="successHintTitle != null and successHintTitle != ''">
                and cc.success_hint_title = #{successHintTitle}
            </if>
            <if test="successHintDesc != null and successHintDesc != ''">
                and cc.success_hint_desc = #{successHintDesc}
            </if>
            <if test="examinationHallRuler != null and examinationHallRuler != ''">
                and cc.examination_hall_ruler = #{examinationHallRuler}
            </if>
            <if test="examinationHallPromise != null and examinationHallPromise != ''">
                and cc.examination_hall_promise = #{examinationHallPromise}
            </if>
            <if test="improperTitle != null and improperTitle != ''">
                and cc.improper_title = #{improperTitle}
            </if>
            <if test="improperDesc != null and improperDesc != ''">
                and cc.improper_desc = #{improperDesc}
            </if>
            <if test="version != null">
                and cc.version = #{version}
            </if>
            <if test="groupIds != null">
                and
                <foreach collection="groupIds" item="groupId" open="(" close=")" separator=" OR ">
                    FIND_IN_SET(#{groupId}, cc.user_group_ids)
                </foreach>
            </if>
        </where>
        order by cc.create_time desc
    </select>

