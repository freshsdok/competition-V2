# Routing only. No V1 token, HMAC secret or bank encryption keys belong here.
V2_NATIVE_API_TARGET=https://web.ksup.cn
# Must equal the actual V2 Gateway AND platform-app session cookie name.
# This is docker/compose.prod.yaml's current value, not the demo default.
V2_NATIVE_SESSION_COOKIE_NAME=DESHI_PROD_SESSION
V2_NATIVE_PROXY_PORT=5180
