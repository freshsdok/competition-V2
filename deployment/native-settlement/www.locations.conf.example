# Include inside the existing HTTPS server for www.ksup.cn.
# Native files: /data/tianda/v1-native-settlement/www/v2-native/index.html
# Keep the existing V1 root, /prod-api/ and other locations unchanged.
location ^~ /v2-native/assets/ {
    root /data/tianda/v1-native-settlement/www;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
}

location ^~ /v2-native/ {
    root /data/tianda/v1-native-settlement/www;
    try_files $uri $uri/ /v2-native/index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
}

location ^~ /v2-native-api/ {
    # No trailing slash: api-server.mjs strips /v2-native-api itself.
    proxy_pass http://127.0.0.1:5180;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    proxy_send_timeout 35s;
    proxy_intercept_errors off;
    proxy_next_upstream off;
    # Stream sensitive bodies; do not buffer them into nginx temporary files.
    client_max_body_size 64k;
    client_body_buffer_size 64k;
    client_body_in_file_only off;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_cache off;
    # Prevent custom global access_log formats from capturing credentials/body.
    access_log off;
}
