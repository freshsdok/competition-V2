# Merge into the existing web.ksup.cn HTTPS server; REPLACE its /api/ location,
# do not create a second /api/ location. Preserve other deployment-specific rules.
# 28082 is docker/compose.prod.yaml's default loopback gateway port.
location /api/ {
    proxy_pass http://127.0.0.1:28082;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_intercept_errors off;
    proxy_next_upstream off;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    client_body_in_file_only off;
    proxy_cache off;
    # Use body-free, cookie-free logging if observability is needed.
    access_log off;
}
