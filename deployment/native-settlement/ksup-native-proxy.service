[Unit]
Description=Ksup native settlement API adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ksup-native-proxy
EnvironmentFile=/etc/ksup-native-proxy.env
ExecStart=/usr/bin/node /opt/ksup-native-proxy/api-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
